FROM python:3.13-slim
WORKDIR /app
COPY requirements/dagster.lock /tmp/dagster.lock
RUN pip install --no-cache-dir -r /tmp/dagster.lock dagster-webserver==1.13.17
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY configs ./configs
COPY docker/dagster-workspace.yaml ./dagster-workspace.yaml
COPY docker/dagster_home /opt/dagster/dagster_home
CMD ["python", "-c", "from climate_pipeline.orchestrators.dagster_assets import climate_partition; print(climate_partition)"]
